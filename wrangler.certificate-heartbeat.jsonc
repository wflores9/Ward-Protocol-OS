{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ward-certificate-heartbeat",
  "main": "workers/certificate-heartbeat.mjs",
  "compatibility_date": "2026-08-24",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "triggers": {
    "crons": ["23 14 * * *"]
  },
  "vars": {
    "STATUS_URL": "https://raw.githubusercontent.com/wflores9/Ward-Protocol-OS/main/docs/security/evidence/certificate-reproducibility-status.json",
    "MAX_STATUS_AGE_SECONDS": "691200",
    "EXPECTED_CERTIFICATE_COUNT": "1",
    "ALERT_FROM": "Ward Protocol <team@wardprotocol.org>",
    "ALERT_TO": "team@wardprotocol.org"
  },
  "kv_namespaces": [
    {
      "binding": "HEARTBEAT_STATE",
      "id": "72bd001d1a0341b69aa2472eafe3500d"
    }
  ]
}

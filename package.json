{
  "name": "ward-protocol-os-operations",
  "private": true,
  "scripts": {
    "test:certificate-heartbeat": "node --test tests/certificate-heartbeat.test.mjs",
    "cf:heartbeat:dev": "wrangler dev --test-scheduled --config wrangler.certificate-heartbeat.jsonc",
    "cf:heartbeat:deploy": "wrangler deploy --config wrangler.certificate-heartbeat.jsonc",
